# NESS runtime settings
FLASK_SECRET_KEY=
NESS_DB_PATH=data/ness.sqlite3

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Arduino physical alert
ARDUINO_ENABLED=true
ARDUINO_PORT=AUTO
ARDUINO_BAUDRATE=9600

# Optional local LLM
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Fully automatic NESS engine
REALTIME_ENGINE_ENABLED=true
MONITOR_ALL_HTTP_REQUESTS=true
AUTO_AI_ENABLED=true
AUTO_LOG_ANALYSIS_ENABLED=true
AUTO_LOG_ANALYSIS_INTERVAL_SECONDS=60
HIGH_REQUEST_RATE_THRESHOLD=120

# Integrated cyber lab (no WSL / VM / Docker / Npcap)
LAB_ENABLED=true
LAB_AUTO_START=true
LAB_EVENT_POLL_MS=900
LAB_PORT_SCAN_THRESHOLD=12
LAB_HOST_SWEEP_THRESHOLD=8
LAB_SYN_RATE_THRESHOLD=80
LAB_ICMP_RATE_THRESHOLD=40
NETWORK_FLOW_RETENTION_HOURS=24

# Security / proxy
TRUST_PROXY_HEADERS=false
