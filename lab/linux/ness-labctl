scenario(){
  local key="${1:-}"; local out=""; local code=0
  if ! ns_exists "$NS_GW"; then echo '{"ok":false,"error":"Cyber range is not running"}'; exit 2; fi
  case "$key" in
    ping_web)
      out=$(ip netns exec "$NS_CLIENT" ping -c 4 -W 1 10.10.20.20 2>&1) || code=$?
      ;;
    normal_http)
      out=$(ip netns exec "$NS_CLIENT" python3 -c "import urllib.request; print(urllib.request.urlopen('http://10.10.20.20:8080/api/health',timeout=4).read().decode())" 2>&1) || code=$?
      ;;
    send_message)
      out=$(ip netns exec "$NS_CLIENT" python3 -c "import json,urllib.request; d=json.dumps({'message':'Hello from the real NESS client namespace'}).encode(); r=urllib.request.Request('http://10.10.20.20:8080/api/messages',data=d,headers={'Content-Type':'application/json'},method='POST'); print(urllib.request.urlopen(r,timeout=4).read().decode())" 2>&1) || code=$?
      ;;
    sql_injection)
      out=$(ip netns exec "$NS_ATTACK" python3 -c "import urllib.parse,urllib.request; d=urllib.parse.urlencode({'username':\"admin' OR '1'='1' --\",'password':'x'}).encode(); r=urllib.request.Request('http://10.10.20.20:8080/login',data=d,method='POST'); print(urllib.request.urlopen(r,timeout=4).read().decode())" 2>&1) || code=$?
      ;;
    xss)
      out=$(ip netns exec "$NS_ATTACK" python3 -c "import urllib.parse,urllib.request; q=urllib.parse.quote('<script>alert(1)</script>'); print(urllib.request.urlopen('http://10.10.20.20:8080/echo?q='+q,timeout=4).read().decode())" 2>&1) || code=$?
      ;;
    traversal)
      out=$(ip netns exec "$NS_ATTACK" python3 -c "import urllib.parse,urllib.request; q=urllib.parse.quote('../secret.txt'); print(urllib.request.urlopen('http://10.10.20.20:8080/files?name='+q,timeout=4).read().decode())" 2>&1) || code=$?
      ;;
    port_scan)
      out=$(ip netns exec "$NS_ATTACK" python3 -c "import socket; ports=[20,21,22,23,25,53,80,110,143,443,445,3389,5432,8000,8080,8443]; rs=[]
for p in ports:
 s=socket.socket();s.settimeout(.12);r=s.connect_ex(('10.10.20.20',p));rs.append((p,r));s.close()
print(rs)" 2>&1) || code=$?
      ;;
    auth_burst)
      out=$(ip netns exec "$NS_ATTACK" python3 -c "import urllib.parse,urllib.request
for i in range(9):
 d=urllib.parse.urlencode({'username':'admin','password':'bad-'+str(i)}).encode(); r=urllib.request.Request('http://10.10.20.20:8080/login',data=d,method='POST')
 try: urllib.request.urlopen(r,timeout=2).read()
 except Exception: pass
print('9 authentication attempts sent')" 2>&1) || code=$?
      ;;
    icmp_burst)
      out=$(ip netns exec "$NS_ATTACK" ping -c 45 -i 0.03 -W 1 10.10.20.20 2>&1) || code=$?
      ;;
    host_sweep)
      out=$(ip netns exec "$NS_ATTACK" python3 -c "import socket
for x in range(2,13):
 s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.settimeout(.05);s.connect_ex(('10.10.20.'+str(x),80));s.close()
print('11 DMZ hosts probed')" 2>&1) || code=$?
      ;;
    *) echo '{"ok":false,"error":"Unknown or disallowed scenario"}'; exit 2;;
  esac
  python3 - "$key" "$code" "$out" <<'PY'
import json,sys
key,code,out=sys.argv[1],int(sys.argv[2]),sys.argv[3]
print(json.dumps({'ok':code==0,'scenario':key,'exitCode':code,'output':out[-4000:]},ensure_ascii=False))
PY
}

case "${1:-status}" in
  start) start_lab; status_json;;
  stop) stop_lab; status_json;;
  reset) stop_lab; rm -rf "$STATE_DIR"/*; mkdir -p "$STATE_DIR"; start_lab; status_json;;
  status) status_json;;
  devices) devices_json;;
  topology) topology_json;;
  events)
    shift
    after=0
    limit=400
    while (($#)); do
      case "$1" in
        --after)
          [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo '{"ok":false,"error":"--after must be a non-negative integer"}'; exit 2; }
          after="$2"; shift 2;;
        --limit)
          [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo '{"ok":false,"error":"--limit must be a positive integer"}'; exit 2; }
          limit="$2"; (( limit >= 1 && limit <= 2000 )) || { echo '{"ok":false,"error":"--limit must be between 1 and 2000"}'; exit 2; }
          shift 2;;
        *)
          echo '{"ok":false,"error":"events accepts only --after N and --limit N"}'; exit 2;;
      esac
    done
    exec python3 "$OPT_DIR/read_events.py" --after "$after" --limit "$limit";;
  scenario) shift; scenario "${1:-}";;
  *) echo '{"ok":false,"error":"Allowed commands: start, stop, reset, status, devices, topology, events, scenario"}'; exit 2;;
esac
