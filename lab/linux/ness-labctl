#!/usr/bin/env bash
set -euo pipefail
STATE_DIR=/var/lib/ness-lab
RUN_DIR=/run/ness-lab
OPT_DIR=/opt/ness-lab
EVENTS="$STATE_DIR/events.jsonl"
mkdir -p "$STATE_DIR" "$RUN_DIR"
chmod 755 "$STATE_DIR" "$RUN_DIR"

NS_CLIENT=ness_client
NS_ATTACK=ness_attacker
NS_WEB=ness_web
NS_DB=ness_db
NS_GW=ness_gateway
BR_USERS=ness_br_users
BR_DMZ=ness_br_dmz
BR_DATA=ness_br_data

jesc(){ python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }
ns_exists(){ ip netns list | awk '{print $1}' | grep -qx "$1"; }
link_exists(){ ip link show "$1" >/dev/null 2>&1; }

stop_pid(){ local f="$1"; if [[ -f "$f" ]]; then local p; p=$(cat "$f" 2>/dev/null || true); if [[ -n "${p:-}" ]]; then kill "$p" >/dev/null 2>&1 || true; sleep 0.15; kill -9 "$p" >/dev/null 2>&1 || true; fi; rm -f "$f"; fi; }

stop_lab(){
  stop_pid "$RUN_DIR/sensor.pid"; stop_pid "$RUN_DIR/web.pid"; stop_pid "$RUN_DIR/db.pid"
  for ns in "$NS_CLIENT" "$NS_ATTACK" "$NS_WEB" "$NS_DB" "$NS_GW"; do ip netns del "$ns" >/dev/null 2>&1 || true; done
  for br in "$BR_USERS" "$BR_DMZ" "$BR_DATA"; do ip link del "$br" >/dev/null 2>&1 || true; done
}

mkbridge(){ local br="$1"; if ! link_exists "$br"; then ip link add "$br" type bridge; fi; ip link set "$br" up; }

mkns(){ local ns="$1"; if ! ns_exists "$ns"; then ip netns add "$ns"; fi; ip -n "$ns" link set lo up; }

attach_host(){
  local ns="$1" hostif="$2" nsif="$3" br="$4" ipcidr="$5" mac="$6" gw="$7"
  ip link del "$hostif" >/dev/null 2>&1 || true
  ip link add "$hostif" type veth peer name "$nsif"
  ip link set "$hostif" master "$br"; ip link set "$hostif" up
  ip link set "$nsif" netns "$ns"
  ip -n "$ns" link set "$nsif" address "$mac"
  ip -n "$ns" addr flush dev "$nsif" || true
  ip -n "$ns" addr add "$ipcidr" dev "$nsif"
  ip -n "$ns" link set "$nsif" up
  ip -n "$ns" route replace default via "$gw"
}

attach_gateway(){
  local hostif="$1" gwif="$2" br="$3" ipcidr="$4" mac="$5"
  ip link del "$hostif" >/dev/null 2>&1 || true
  ip link add "$hostif" type veth peer name "$gwif"
  ip link set "$hostif" master "$br"; ip link set "$hostif" up
  ip link set "$gwif" netns "$NS_GW"
  ip -n "$NS_GW" link set "$gwif" address "$mac"
  ip -n "$NS_GW" addr flush dev "$gwif" || true
  ip -n "$NS_GW" addr add "$ipcidr" dev "$gwif"
  ip -n "$NS_GW" link set "$gwif" up
}

start_services(){
  : > "$EVENTS"
  rm -f "$STATE_DIR/messages.jsonl"
  mkdir -p "$STATE_DIR/webroot/files"
  # Separate real services inside their network namespaces.
  ip netns exec "$NS_DB" nohup python3 "$OPT_DIR/ness_lab_db.py" --bind 10.10.30.30 --port 5432 --events "$EVENTS" --messages "$STATE_DIR/messages.jsonl" >"$STATE_DIR/db.log" 2>&1 & echo $! > "$RUN_DIR/db.pid"
  sleep 0.25
  ip netns exec "$NS_WEB" nohup python3 "$OPT_DIR/ness_lab_web.py" --bind 10.10.20.20 --port 8080 >"$STATE_DIR/web.log" 2>&1 & echo $! > "$RUN_DIR/web.pid"
  sleep 0.25
  ip netns exec "$NS_GW" nohup python3 "$OPT_DIR/ness_lab_sensor.py" --events "$EVENTS" \
      --interface gw_users=10.10.10.0/24 --interface gw_dmz=10.10.20.0/24 --interface gw_data=10.10.30.0/24 >"$STATE_DIR/sensor.log" 2>&1 & echo $! > "$RUN_DIR/sensor.pid"
  sleep 0.35
}

start_lab(){
  stop_lab
  mkbridge "$BR_USERS"; mkbridge "$BR_DMZ"; mkbridge "$BR_DATA"
  mkns "$NS_CLIENT"; mkns "$NS_ATTACK"; mkns "$NS_WEB"; mkns "$NS_DB"; mkns "$NS_GW"
  attach_host "$NS_CLIENT" v_client client0 "$BR_USERS" 10.10.10.11/24 02:42:0a:0a:0a:0b 10.10.10.1
  attach_host "$NS_ATTACK" v_attack attack0 "$BR_USERS" 10.10.10.40/24 02:42:0a:0a:0a:28 10.10.10.1
  attach_host "$NS_WEB" v_web web0 "$BR_DMZ" 10.10.20.20/24 02:42:0a:0a:14:14 10.10.20.1
  attach_host "$NS_DB" v_db db0 "$BR_DATA" 10.10.30.30/24 02:42:0a:0a:1e:1e 10.10.30.1
  attach_gateway v_gwu gw_users "$BR_USERS" 10.10.10.1/24 02:42:0a:0a:0a:01
  attach_gateway v_gwd gw_dmz "$BR_DMZ" 10.10.20.1/24 02:42:0a:0a:14:01
  attach_gateway v_gwb gw_data "$BR_DATA" 10.10.30.1/24 02:42:0a:0a:1e:01
  ip netns exec "$NS_GW" sysctl -q -w net.ipv4.ip_forward=1
  # The cyber range is intentionally isolated. No NAT/default route to the Internet is created.
  start_services
}

pid_alive(){ local f="$1"; [[ -f "$f" ]] && kill -0 "$(cat "$f")" >/dev/null 2>&1; }

status_json(){
  local running=false sensor=false web=false db=false
  if ns_exists "$NS_GW" && ns_exists "$NS_CLIENT" && ns_exists "$NS_ATTACK" && ns_exists "$NS_WEB" && ns_exists "$NS_DB"; then running=true; fi
  pid_alive "$RUN_DIR/sensor.pid" && sensor=true || true
  pid_alive "$RUN_DIR/web.pid" && web=true || true
  pid_alive "$RUN_DIR/db.pid" && db=true || true
  printf '{"ok":true,"installed":true,"running":%s,"sensorRunning":%s,"webRunning":%s,"dbRunning":%s,"mode":"WSL2 Linux Network Namespaces","internetAccess":false,"usersCidr":"10.10.10.0/24","dmzCidr":"10.10.20.0/24","dataCidr":"10.10.30.0/24"}\n' "$running" "$sensor" "$web" "$db"
}

